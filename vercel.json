{
    "version": 2,
    "name": "mahadev-photography",
    "routes": [{
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ],
    "headers": [{
        "source": "/(.*)",
        "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=300, must-revalidate"
            },
            {
                "key": "Access-Control-Allow-Origin",
                "value": "*"
            }
        ]
    }]
}