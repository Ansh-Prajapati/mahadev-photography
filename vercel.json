{
    "version": 2,
    "name": "mahadev-photography",
    "headers": [{
        "source": "/(.*)",
        "headers": [{
                "key": "Cache-Control",
                "value": "no-cache, no-store, must-revalidate"
            },
            {
                "key": "Pragma",
                "value": "no-cache"
            },
            {
                "key": "Expires",
                "value": "0"
            }
        ]
    }]
}